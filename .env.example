# 知序掌握度后端配置示例
# 复制为 .env 后填入真实值（.env 不会被提交到仓库）

# 监听
ZHIXU_PORT=8787
ZHIXU_HOST=127.0.0.1

# 数据库与静态目录
# ZHIXU_DB=server/data/zhixu.db
# ZHIXU_STATIC=dist

# 同一用户+节点两次评估的最小间隔（毫秒）
ZHIXU_EVAL_MIN_INTERVAL_MS=30000

# Jev（TypeSafe）：开启后需填 Key
ZHIXU_JEV_ENABLED=false
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
# TYPESAFE_TIMEOUT_MS=20000
# TYPESAFE_MAX_RETRIES=2

# Jev 成本保险丝：当日调用上限（0 表示不限制）。超出后自动回退规则引擎，不影响学习。
ZHIXU_JEV_DAILY_LIMIT=300
ZHIXU_JEV_DAILY_LIMIT_PER_IP=30

# 设备令牌：用户数据接口的身份由服务端签发，客户端无法冒充别人的 userId。
# 留空则每次启动随机生成（重启后老令牌失效，前端会自动重新申请）。
ZHIXU_SESSION_SECRET=
# false 可退回旧的「请求头自称 userId」模式（不建议线上使用）
ZHIXU_REQUIRE_SESSION=true
# 令牌有效期（毫秒），默认 30 天
# ZHIXU_SESSION_TTL_MS=2592000000

# 写接口按客户端 IP 限流，防止脚本批量注入
ZHIXU_RATE_PER_MIN=60
ZHIXU_RATE_PER_DAY=2000

# 只读数据观察台（/math-modeling/admin.html）：留空则整套管理接口关闭
ZHIXU_ADMIN_TOKEN=
# 观察台单次查询返回的最大行数
ZHIXU_ADMIN_MAX_ROWS=200

# 镜像到 MySQL（供博客数据库工作台浏览，脚本 scripts/mirror-to-mysql.cjs）
# 每张表最多镜像的最新行数，默认 5000
# ZHIXU_MIRROR_MAX_ROWS=5000
