# 知序掌握度后端配置示例
# 复制为 .env 后填入真实值（.env 不会被提交到仓库）

# 监听
ZHIXU_PORT=8787
ZHIXU_HOST=127.0.0.1

# 数据库与静态目录
# ZHIXU_DB=server/data/zhixu.db
# ZHIXU_STATIC=dist

# 同一用户+节点两次评估的最小间隔（毫秒）
ZHIXU_EVAL_MIN_INTERVAL_MS=30000

# Jev（TypeSafe）：开启后需填 Key
ZHIXU_JEV_ENABLED=false
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
# TYPESAFE_TIMEOUT_MS=20000
# TYPESAFE_MAX_RETRIES=2
